# KannadaConnect Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local Connection String
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/kannadaconnect?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/kannadaconnect

# JWT Configuration
JWT_SECRET=replace_this_with_a_secure_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# Frontend Client Origin
CLIENT_URL=http://localhost:5173

# Initial Administrator Account (Configured via seed script)
ADMIN_EMAIL=admin@kannadaconnect.org
ADMIN_PASSWORD=Admin@12345
