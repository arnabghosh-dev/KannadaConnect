# KannadaConnect Full-Stack Workspace Environment Template

# --- BACKEND (server/.env) ---
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/kannadaconnect
JWT_SECRET=replace_this_with_a_secure_random_string_min_32_chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@kannadaconnect.org
ADMIN_PASSWORD=Admin@12345

# --- FRONTEND (frontend/.env) ---
VITE_API_URL=/api
